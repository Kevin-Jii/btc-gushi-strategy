# Binance API 凭证。不要提交真实的 .env 文件。
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 默认使用 testnet；live 还需要填写下面的精确确认字符串。
BINANCE_MODE=testnet
BINANCE_LIVE_CONFIRM=
BINANCE_SYMBOL=BTCUSDT
BINANCE_INTERVAL=1d
BINANCE_QUOTE_ASSET=USDT
BINANCE_POSITION_FRACTION=0.5
BINANCE_HISTORY_LIMIT=300

# 只有明确要在重启时接管已有 BTC 余额时才设置为 true。
BINANCE_ADOPT_EXISTING_POSITION=false

# 选择 OKX 时设置 TRADING_PLATFORM=okx；默认使用 OKX 模拟盘。
TRADING_PLATFORM=binance
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_MODE=demo
OKX_LIVE_CONFIRM=
OKX_INST_ID=BTC-USDT
OKX_INTERVAL=1d
OKX_BAR=1D
OKX_QUOTE_ASSET=USDT
OKX_POSITION_FRACTION=0.5
OKX_HISTORY_LIMIT=300
OKX_ADOPT_EXISTING_POSITION=false

# 是否启用 LangChain 策略审核；默认关闭，不影响原有确定性策略。
LANGCHAIN_ENABLED=false

# advisory：只记录建议；veto：AI 可以否决确定性策略的入场。
# 无论哪种模式，AI 都不能直接创建订单，也不能绕过止损。
LANGCHAIN_DECISION_MODE=advisory
LANGCHAIN_MODEL=gpt-4o-mini
LANGCHAIN_OPENAI_API_KEY=
LANGCHAIN_BASE_URL=
LANGCHAIN_MIN_INTERVAL_MS=900000
LANGCHAIN_MIN_CONFIDENCE=0.7
