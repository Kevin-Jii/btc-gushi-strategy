# OKX API 凭证。不要提交真实的 .env 文件。
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# 默认使用 OKX 真实永续合约；启动真实交易前必须填写精确确认字符串。
TRADING_PLATFORM=okx
OKX_MODE=live
OKX_INSTRUMENT_TYPE=SWAP
OKX_LIVE_CONFIRM=
OKX_INST_ID=BTC-USDT-SWAP
OKX_INTERVAL=1d
OKX_BAR=1D
OKX_QUOTE_ASSET=USDT
OKX_POSITION_FRACTION=0.5
OKX_HISTORY_LIMIT=300

# 只有明确要在重启时接管已有持仓时才设置为 true。
OKX_ADOPT_EXISTING_POSITION=false
# PostgreSQL 持久化：默认开启；没有 DATABASE_URL 时 dashboard 启动会失败。
# 本地开发可使用 docker compose up -d postgres（见 docker-compose.yml）。
DATABASE_URL=postgresql://trading:trading@127.0.0.1:5432/trading
POSTGRES_ENABLED=true
POSTGRES_SSL=false
POSTGRES_POOL_MAX=10

# 是否启用 LangChain 策略审核；默认关闭，不影响原有确定性策略。
LANGCHAIN_ENABLED=false

# advisory：只记录建议；veto：AI 可以否决确定性策略的入场。
# 无论哪种模式，AI 都不能直接创建订单，也不能绕过止损。
LANGCHAIN_DECISION_MODE=advisory
LANGCHAIN_MODEL=gpt-4o-mini
LANGCHAIN_OPENAI_API_KEY=
LANGCHAIN_BASE_URL=
LANGCHAIN_MIN_INTERVAL_MS=900000
LANGCHAIN_MIN_CONFIDENCE=0.7
